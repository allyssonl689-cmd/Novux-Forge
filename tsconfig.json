{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*":            ["src/*"],
      "@/theme":        ["src/theme/index.ts"],
      "@/components/*": ["src/components/*"],
      "@/features/*":   ["src/features/*"],
      "@/lib/*":        ["src/lib/*"],
      "@/types/*":      ["src/types/*"],
      "@/hooks/*":      ["src/hooks/*"]
    }
  }
}
